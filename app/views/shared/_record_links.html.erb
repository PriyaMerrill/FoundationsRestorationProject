<%# A titled group of record links; renders nothing when the list is empty.
    locals: title, records %>
<% if records.any? %>
  <section class="mt-8">
    <h2 class="text-2xl font-bold"><%= title %></h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      <% records.each do |record| %>
        <li><%= render "shared/record_link", record: record %></li>
      <% end %>
    </ul>
  </section>
<% end %>
