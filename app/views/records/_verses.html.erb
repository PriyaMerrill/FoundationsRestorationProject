<%# The text of a revelation. The first few verses show straight away; the
    rest open on request so a long section does not bury the rest of the page.
    locals: revelation %>
<% verses = revelation.verses.to_a %>
<% preview = 5 %>
<% if verses.any? %>
  <section class="mt-10" aria-labelledby="text-heading">
    <h2 id="text-heading" class="text-2xl font-bold">The text</h2>
    <p class="mt-1 text-base text-brown-700"><%= revelation.title %>, <%= pluralize(verses.size, "verse") %></p>

    <div class="mt-4 rounded-lg border border-parchment-300 bg-white p-5 sm:p-6">
      <ol class="list-none space-y-3 font-serif text-lg leading-relaxed text-slate-900">
        <% verses.first(preview).each do |verse| %>
          <%= render "records/verse", verse: verse %>
        <% end %>
      </ol>

      <% if verses.size > preview %>
        <details class="group mt-3">
          <summary class="cursor-pointer rounded-md py-2 font-sans text-base font-semibold text-forest-700">
            <span class="group-open:hidden">Show all <%= verses.size %> verses</span>
            <span class="hidden group-open:inline">Show fewer verses</span>
          </summary>
          <ol class="mt-3 list-none space-y-3 font-serif text-lg leading-relaxed text-slate-900" start="<%= preview + 1 %>">
            <% verses.drop(preview).each do |verse| %>
              <%= render "records/verse", verse: verse %>
            <% end %>
          </ol>
        </details>
      <% end %>
    </div>

    <p class="mt-3 text-sm text-slate-600">
      Verse text from the <%= link_to "Open Scripture API", "https://openscriptureapi.org", class: "text-link font-normal", rel: "noopener" %>.
      <% if revelation.official_url %>
        <%= link_to "Read #{revelation.reference} in the official edition", revelation.official_url, class: "text-link font-normal", rel: "noopener" %>, with its heading and footnotes.
      <% end %>
    </p>
  </section>
<% end %>
