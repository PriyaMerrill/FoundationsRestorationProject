<%= render layout: "records/header", locals: { record: @record, facts: [ @record.display_date, @record.place&.name ] } do %>
  <% if @record.subjects.present? %>
    <p class="mt-4 flex flex-wrap gap-2">
      <% @record.subjects.split(",").each do |subject| %>
        <%= render "shared/badge", label: subject.strip, tone: "gold" %>
      <% end %>
    </p>
  <% end %>
<% end %>

<article class="page-narrow py-10">
  <%# The stored facts, plus the things the record already knows about itself. %>
  <% facts = @record.fact_list %>
  <% facts += [ [ "Verses", @record.verses.size.to_s ] ] if @record.verses.any? %>
  <%= render "records/facts", facts: facts %>

  <p class="text-xl"><%= @record.summary %></p>

  <% if @record.context.present? %>
    <h2 class="mt-8 text-2xl font-bold">Historical context</h2>
    <p class="mt-3"><%= @record.context %></p>
  <% end %>

  <%= render "records/verses", revelation: @record %>

  <%= render "shared/record_links", title: "People", records: @record.people.order(:name) %>
  <%= render "shared/record_links", title: "Where it was received", records: [ @record.place ].compact %>
  <%= render "shared/record_links", title: "Related events", records: @record.events.chronological %>
  <%= render "shared/sources", record: @record %>
</article>
