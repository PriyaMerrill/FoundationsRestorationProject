<%# One verse, with its number. Each can be linked to directly: /revelations/dc-76#verse-22 %>
<li id="verse-<%= verse.number %>" class="flex scroll-mt-6 gap-3 target:bg-gold-200">
  <span class="w-8 shrink-0 pt-1 text-right font-sans text-sm font-bold text-gold-700"><%= verse.number %></span>
  <span class="min-w-0"><%= verse.text %></span>
</li>
