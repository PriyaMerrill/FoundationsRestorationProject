<%= turbo_frame_tag "panel" do %>
  <article class="p-6" data-panel-key="<%= @record.slug %>">
    <p class="eyebrow">Place<% if @record.trail_order %> · Stop <%= @record.trail_order %><% end %></p>
    <h2 class="mt-1 text-3xl font-bold"><%= @record.name %></h2>
    <p class="mt-2 text-lg text-brown-700">
      <%= [ @record.state, @record.years, (@record.modern_name.present? ? "Today: #{@record.modern_name}" : nil) ].compact_blank.join(" · ") %>
    </p>

    <p class="mt-3 flex flex-wrap gap-2">
      <% @record.kinds.each do |kind| %>
        <%= render "shared/badge", label: kind.humanize, tone: "brown" %>
      <% end %>
    </p>

    <%# Marking a place explored: the one place this can be done, so the button is hard to miss. %>
    <button type="button" class="explore-button mt-5" aria-pressed="false"
            data-controller="visited" data-visited-slug-value="<%= @record.slug %>" data-action="visited#toggle">
      <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><path d="M8 12.500l3 3 5-6" data-visited-target="tick" />
      </svg>
      <span>
        <span class="block text-lg font-bold leading-tight" data-visited-target="label">Mark as explored</span>
        <span class="block text-sm font-normal" data-visited-target="hint">Stamp this place on your road trip</span>
      </span>
    </button>

    <%= render "shared/then_and_now", record: @record %>

    <p class="mt-5"><%= @record.summary %></p>
    <% if @record.significance.present? %>
      <h3 class="mt-6 text-xl font-bold">Why it matters</h3>
      <p class="mt-2 text-base text-slate-700"><%= @record.significance %></p>
    <% end %>

    <% events = @record.events.chronological %>
    <% if events.any? %>
      <h3 class="mt-6 text-xl font-bold">What happened here</h3>
      <ul class="mt-2 space-y-2">
        <% events.each do |event| %>
          <li>
            <%= link_to timeline_path(event: event.slug), class: "record-link flex w-full flex-wrap" do %>
              <span class="text-sm font-semibold text-gold-700"><%= event.display_dates %></span>
              <span class="font-semibold"><%= event.title %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="mt-2 text-sm text-slate-600">Each event opens on the timeline.</p>
    <% end %>

    <% revelations = @record.revelations.order(:section_number) %>
    <% if revelations.any? %>
      <h3 class="mt-6 text-xl font-bold">Scriptures</h3>
      <ul class="mt-2 flex flex-wrap gap-2">
        <% revelations.each do |revelation| %>
          <li><%= render "shared/record_link", record: revelation %></li>
        <% end %>
      </ul>
    <% end %>

    <% people = @record.people.order(:name) %>
    <% if people.any? %>
      <h3 class="mt-6 text-xl font-bold">People</h3>
      <ul class="mt-2 flex flex-wrap gap-2">
        <% people.each do |person| %>
          <li><%= render "shared/record_link", record: person %></li>
        <% end %>
      </ul>
    <% end %>

    <p class="mt-6">
      <%= link_to "Open the full page", place_path(@record), class: "btn btn-outline" %>
    </p>

    <%= render "shared/sources", record: @record %>
  </article>
<% end %>
