<%# One chart with its title, a key when it has more than one colour, a
    click-through area, a table of the same figures, and notes on where the
    numbers come from.
    locals: title, points, type ("line", "bar" or "hbar"), unit (what the value counts),
            description (optional), label_heading (optional),
            series (optional: several coloured parts stacked in each bar),
            key (optional: { "Ohio" => "#238a63" } when bars are coloured one by one),
            accent (optional: the colour of the stripe across the top of the card)
    The block holds the source notes and caveats. %>
<% series = local_assigns.fetch(:series, []) %>
<% key = series.any? ? series.to_h { |part| [ part.name, part.color ] } : local_assigns.fetch(:key, {}) %>
<section class="card chart-card" style="--accent: <%= local_assigns.fetch(:accent, "#1f7a4a") %>" data-controller="chart"
         data-chart-type-value="<%= type %>" data-chart-unit-value="<%= unit %>"
         data-chart-points-value="<%= chart_points_json(points) %>"
         data-chart-series-value="<%= series.map(&:to_h).to_json %>">
  <h2 class="text-2xl font-bold"><%= title %></h2>
  <% if local_assigns[:description].present? %>
    <p class="mt-1 text-base text-slate-700"><%= description %></p>
  <% end %>

  <% if points.empty? %>
    <p class="mt-6 rounded-md bg-parchment-100 p-4 text-base text-slate-700">Nothing falls in the years chosen.</p>
  <% else %>
    <% if key.any? %>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-800" aria-label="Key">
        <% key.each do |name, color| %>
          <li class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm" style="background: <%= color %>" aria-hidden="true"></span><%= name %></li>
        <% end %>
      </ul>
    <% end %>

    <%# A horizontal bar chart grows with its number of bars, so the bars stay a steady thickness. %>
    <div class="relative mt-4 <%= "h-72" unless type == "hbar" %>"
         <% if type == "hbar" %>style="height: <%= 3 + points.size * 2.5 %>rem"<% end %>>
      <canvas data-chart-target="canvas" role="img" aria-label="<%= title %>. The same figures are in the table below."></canvas>
    </div>

    <%# Filled in when a visitor chooses a bar or point. %>
    <div class="mt-3 rounded-md border border-parchment-300 bg-parchment-100 p-3 text-base" data-chart-target="detail" aria-live="polite" hidden></div>
    <p class="mt-2 text-sm text-slate-600" data-chart-target="hint">Choose a <%= type == "line" ? "point" : "bar" %> to see what it counts.</p>

    <details class="mt-3 text-base">
      <summary class="cursor-pointer font-semibold text-forest-700">Show as a table</summary>
      <table class="mt-2 w-full text-left">
        <thead>
          <tr class="border-b border-parchment-300 text-sm text-slate-600">
            <th scope="col" class="py-1 pr-3 font-semibold"><%= local_assigns.fetch(:label_heading, "Item") %></th>
            <th scope="col" class="py-1 pr-3 text-right font-semibold"><%= unit.capitalize %></th>
            <% series.each do |part| %>
              <th scope="col" class="py-1 pr-3 text-right font-semibold"><%= part.name %></th>
            <% end %>
            <% if points.any? { |point| point.records.any? } %><th scope="col" class="py-1 font-semibold">Records</th><% end %>
          </tr>
        </thead>
        <tbody>
          <% points.each_with_index do |point, index| %>
            <tr class="border-b border-parchment-200 align-top">
              <th scope="row" class="py-1 pr-3 font-normal"><%= point.label %></th>
              <td class="py-1 pr-3 text-right tabular-nums"><%= number_with_delimiter(point.value) %></td>
              <% series.each do |part| %>
                <td class="py-1 pr-3 text-right tabular-nums"><%= part.values[index] %></td>
              <% end %>
              <% if points.any? { |candidate| candidate.records.any? } %>
                <td class="py-1 text-sm">
                  <% point.records.each_with_index do |record, position| %><%= ", " if position.positive? %><% link = chart_record(record) %><%= link_to link[:label], link[:url], class: "text-link font-normal" %><% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </details>
  <% end %>

  <% notes = capture { yield } %>
  <% if notes.present? %>
    <div class="mt-4 border-t border-parchment-300 pt-3 text-sm text-slate-600"><%= notes %></div>
  <% end %>
</section>
