<%# The sources that support a record. locals: record %>
<section class="mt-10 rounded-lg border border-parchment-300 bg-parchment-100 p-6">
  <h2 class="text-xl font-bold">Sources</h2>
  <% citations = record.citations.includes(:source) %>
  <% if citations.any? %>
    <ul class="mt-3 space-y-2 text-base">
      <% citations.each do |citation| %>
        <li>
          <% if citation.source.url.present? %>
            <%= link_to citation.source.title, citation.source.url, class: "text-link", rel: "noopener" %>
          <% else %>
            <span class="font-semibold"><%= citation.source.title %></span>
          <% end %>
          <% detail = [ citation.note, (citation.page.present? ? "p. #{citation.page}" : nil) ].compact_blank.join(", ") %>
          <% if detail.present? %><span class="text-slate-600">(<%= detail %>)</span><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-base text-slate-600">No sources have been recorded for this entry yet.</p>
  <% end %>
  <p class="mt-4 text-sm"><%= link_to "About our sources and methodology", sources_path, class: "text-link" %></p>
</section>
