<%# The longer write-up of a person, place or revelation, in titled sections.
    locals: sections (from story_sections) %>
<% sections.each do |heading, paragraphs| %>
  <h2 class="mt-8 text-2xl font-bold"><%= heading %></h2>
  <% paragraphs.each do |paragraph| %>
    <p class="mt-3"><%= paragraph %></p>
  <% end %>
<% end %>
