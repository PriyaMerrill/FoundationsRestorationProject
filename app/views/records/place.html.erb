<%= render layout: "records/header", locals: { record: @record, facts: [ @record.state, @record.years, (@record.modern_name.present? ? "Today: #{@record.modern_name}" : nil) ] } do %>
  <p class="mt-4 flex flex-wrap gap-2">
    <% @record.kinds.each do |kind| %>
      <%= render "shared/badge", label: kind.humanize, tone: "brown" %>
    <% end %>
  </p>
<% end %>

<article class="page-narrow py-10">
  <%= render "records/facts", facts: @record.fact_list %>

  <p class="text-xl"><%= @record.summary %></p>

  <% if @record.significance.present? %>
    <h2 class="mt-8 text-2xl font-bold">Why it matters</h2>
    <p class="mt-3"><%= @record.significance %></p>
  <% end %>

  <%= render "records/story", sections: @record.story_sections %>

  <%= render "shared/record_links", title: "Events here", records: @record.events.chronological %>
  <%= render "shared/record_links", title: "Revelations received here", records: @record.revelations.order(:section_number) %>
  <%= render "shared/record_links", title: "People connected to this place", records: @record.people.order(:name) %>
  <%= render "shared/sources", record: @record %>
</article>
