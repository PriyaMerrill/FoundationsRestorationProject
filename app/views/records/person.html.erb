<% lifespan = [ @record.birth_date&.year, @record.death_date&.year ].compact.join("–") %>
<% portrait = @record.portrait %>
<%= render layout: "records/header", locals: { record: @record, facts: [ lifespan, @record.roles ] } do %><% end %>

<article class="page-narrow py-10">
  <% if portrait&.available? %>
    <figure class="mx-auto mb-6 w-56 sm:float-right sm:mb-4 sm:ml-8 sm:w-60">
      <%= image_tag portrait.file_name, alt: "Portrait of #{@record.name}", class: "w-full rounded-md border border-parchment-300 bg-parchment-200 shadow-sm" %>
      <figcaption class="mt-2 text-sm text-slate-600">
        <%= portrait.caption %>
        <% if portrait.credit.present? %><span class="block"><%= portrait.credit %></span><% end %>
        <% if portrait.source_url.present? %>
          <%= link_to "Image source", portrait.source_url, class: "text-link font-normal", rel: "noopener" %>
        <% end %>
      </figcaption>
    </figure>
  <% end %>

  <%# The biography and facts sit beside the portrait; "overflow-hidden" keeps them in their own column. %>
  <div class="overflow-hidden">
    <p class="text-xl"><%= @record.biography %></p>
    <div class="mt-6">
      <%= render "records/facts", facts: @record.fact_list %>
    </div>
  </div>

  <div class="clear-both">
    <%= render "records/story", sections: @record.story_sections %>
    <%= render "shared/record_links", title: "Events", records: @record.events.chronological %>
    <%= render "shared/record_links", title: "Revelations", records: @record.revelations.order(:section_number) %>
    <%= render "shared/record_links", title: "Places", records: @record.places.order(:name) %>
    <%= render "shared/sources", record: @record %>
  </div>
</article>
